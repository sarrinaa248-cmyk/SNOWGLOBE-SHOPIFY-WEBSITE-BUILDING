{%- liquid
  assign brand = section.settings.brand
  assign heading = section.settings.heading
  assign subheading = section.settings.subheading
  assign button_label = section.settings.button_label
  assign button_link = section.settings.button_link
  assign tagline = section.settings.tagline
-%}

<section
  id="VoraHero-{{ section.id }}"
  class="vora-hero"
  style="
    --vora-ink: {{ section.settings.ink }};
    --vora-paper: {{ section.settings.paper }};
    --vora-accent: {{ section.settings.accent }};
    --vora-pop: {{ section.settings.pop }};
    --vora-min-height: {{ section.settings.min_height }}vh;
  "
>
  <div class="vora-hero__plane">
    {%- if section.settings.image != blank -%}
      {{
        section.settings.image
        | image_url: width: 2400
        | image_tag:
          class: 'vora-hero__image',
          loading: 'eager',
          fetchpriority: 'high',
          sizes: '100vw',
          widths: '750, 1100, 1500, 1800, 2400',
          alt: brand
      }}
    {%- else -%}
      <div class="vora-hero__atmosphere" aria-hidden="true">
        <span class="vora-hero__orb vora-hero__orb--a"></span>
        <span class="vora-hero__orb vora-hero__orb--b"></span>
        <span class="vora-hero__orb vora-hero__orb--c"></span>
        <span class="vora-hero__grid"></span>
      </div>
    {%- endif -%}
    <div class="vora-hero__shade" aria-hidden="true"></div>
  </div>

  <div class="vora-hero__frame">
    {%- if tagline != blank -%}
      <p class="vora-hero__tag">{{ tagline }}</p>
    {%- endif -%}
    <p class="vora-hero__brand">{{ brand }}</p>
    <h1 class="vora-hero__heading">{{ heading }}</h1>
    {%- if subheading != blank -%}
      <p class="vora-hero__sub">{{ subheading }}</p>
    {%- endif -%}
    {%- if button_label != blank -%}
      <a class="vora-hero__cta" href="{{ button_link }}">{{ button_label }}</a>
    {%- endif -%}
  </div>
</section>

{% stylesheet %}
  @import url('https://fonts.googleapis.com/css2?family=Syne:wght@600;700;800&family=Figtree:wght@400;500;600;700&display=swap');

  .vora-hero {
    position: relative;
    isolation: isolate;
    min-height: var(--vora-min-height, 92vh);
    display: grid;
    align-items: end;
    color: var(--vora-paper);
    overflow: clip;
    background: var(--vora-ink);
  }

  .vora-hero__plane {
    position: absolute;
    inset: 0;
    z-index: 0;
  }

  .vora-hero__image {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center;
    display: block;
  }

  .vora-hero__atmosphere {
    position: relative;
    width: 100%;
    height: 100%;
    overflow: hidden;
    background:
      linear-gradient(145deg, #071428 0%, #0a1f3d 42%, #122038 100%);
  }

  .vora-hero__grid {
    position: absolute;
    inset: 0;
    background-image:
      linear-gradient(rgba(255, 255, 255, 0.04) 1px, transparent 1px),
      linear-gradient(90deg, rgba(255, 255, 255, 0.04) 1px, transparent 1px);
    background-size: 48px 48px;
    mask-image: radial-gradient(ellipse 70% 60% at 60% 40%, black, transparent);
  }

  .vora-hero__orb {
    position: absolute;
    border-radius: 50%;
    filter: blur(8px);
  }

  .vora-hero__orb--a {
    width: min(55vw, 28rem);
    height: min(55vw, 28rem);
    top: 8%;
    right: 6%;
    background: color-mix(in srgb, var(--vora-accent) 55%, transparent);
  }

  .vora-hero__orb--b {
    width: min(40vw, 18rem);
    height: min(40vw, 18rem);
    bottom: 12%;
    left: 8%;
    background: color-mix(in srgb, var(--vora-pop) 45%, transparent);
  }

  .vora-hero__orb--c {
    width: min(28vw, 12rem);
    height: min(28vw, 12rem);
    top: 42%;
    left: 42%;
    background: color-mix(in srgb, #ffd166 35%, transparent);
  }

  .vora-hero__shade {
    position: absolute;
    inset: 0;
    background:
      linear-gradient(180deg, rgba(5, 12, 28, 0.2) 0%, rgba(5, 12, 28, 0.15) 40%, rgba(5, 12, 28, 0.82) 100%),
      linear-gradient(90deg, rgba(5, 12, 28, 0.55) 0%, rgba(5, 12, 28, 0.12) 55%, transparent 100%);
  }

  .vora-hero__frame {
    position: relative;
    z-index: 1;
    width: min(100% - 2.5rem, 44rem);
    padding: 4.5rem 0 3.5rem;
    margin-inline: clamp(1.25rem, 5vw, 4.5rem);
    display: grid;
    gap: 0.85rem;
  }

  .vora-hero__tag {
    margin: 0;
    justify-self: start;
    padding: 0.35rem 0.7rem;
    font-family: Figtree, sans-serif;
    font-size: 0.78rem;
    font-weight: 700;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--vora-ink);
    background: var(--vora-pop);
    transform: rotate(-1.5deg);
  }

  .vora-hero__brand {
    margin: 0;
    font-family: Syne, sans-serif;
    font-weight: 800;
    font-size: clamp(3rem, 10vw, 6rem);
    letter-spacing: -0.045em;
    line-height: 0.9;
    text-transform: uppercase;
  }

  .vora-hero__heading {
    margin: 0;
    max-width: 16ch;
    font-family: Syne, sans-serif;
    font-weight: 700;
    font-size: clamp(1.45rem, 3.4vw, 2.15rem);
    letter-spacing: -0.02em;
    line-height: 1.12;
  }

  .vora-hero__sub {
    margin: 0;
    max-width: 34ch;
    font-family: Figtree, sans-serif;
    font-size: 1.08rem;
    line-height: 1.45;
    color: color-mix(in srgb, var(--vora-paper) 84%, transparent);
  }

  .vora-hero__cta {
    justify-self: start;
    margin-top: 0.65rem;
    display: inline-flex;
    align-items: center;
    min-height: 3.1rem;
    padding: 0.9rem 1.4rem;
    font-family: Figtree, sans-serif;
    font-size: 0.98rem;
    font-weight: 700;
    letter-spacing: 0.01em;
    text-decoration: none;
    color: var(--vora-ink);
    background: var(--vora-accent);
    box-shadow: 4px 4px 0 color-mix(in srgb, var(--vora-pop) 80%, black);
    transition: transform 200ms ease, box-shadow 200ms ease;
  }

  .vora-hero__cta:hover {
    transform: translate(-2px, -2px);
    box-shadow: 6px 6px 0 color-mix(in srgb, var(--vora-pop) 80%, black);
  }

  .vora-hero__cta:focus-visible {
    outline: 2px solid var(--vora-paper);
    outline-offset: 3px;
  }

  @media (prefers-reduced-motion: reduce) {
    .vora-hero__cta {
      transition: none;
    }

    .vora-hero__cta:hover {
      transform: none;
    }
  }

  @media (min-width: 900px) {
    .vora-hero {
      align-items: center;
    }

    .vora-hero__frame {
      padding-block: 5rem;
    }
  }
{% endstylesheet %}

{% javascript %}
  (() => {
    if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) return;
    document.querySelectorAll('.vora-hero__frame').forEach((frame) => {
      if (frame.dataset.animated === 'true') return;
      frame.dataset.animated = 'true';
      frame.animate(
        [
          { opacity: 0, transform: 'translateY(18px)' },
          { opacity: 1, transform: 'translateY(0)' }
        ],
        { duration: 700, easing: 'cubic-bezier(0.22, 1, 0.36, 1)', fill: 'both' }
      );
    });
  })();
{% endjavascript %}

{% schema %}
{
  "name": "Vora hero",
  "tag": "section",
  "class": "section-vora-hero",
  "settings": [
    {
      "type": "text",
      "id": "tagline",
      "label": "Tag line",
      "default": "Move-in season · Desk kit"
    },
    {
      "type": "text",
      "id": "brand",
      "label": "Brand name",
      "default": "Vora"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Desk ready. Dorm ready."
    },
    {
      "type": "textarea",
      "id": "subheading",
      "label": "Supporting text",
      "default": "Back-to-school desk kit for late nights, clean setups, and rooms that finally feel finished."
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "Button label",
      "default": "Shop the desk bundle"
    },
    {
      "type": "url",
      "id": "button_link",
      "label": "Button link"
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "Hero image",
      "info": "Upload a dorm desk lifestyle photo for the strongest look."
    },
    {
      "type": "range",
      "id": "min_height",
      "label": "Section height",
      "min": 70,
      "max": 100,
      "step": 1,
      "unit": "vh",
      "default": 92
    },
    {
      "type": "color",
      "id": "ink",
      "label": "Background ink",
      "default": "#071428"
    },
    {
      "type": "color",
      "id": "paper",
      "label": "Text color",
      "default": "#f4f7fb"
    },
    {
      "type": "color",
      "id": "accent",
      "label": "Accent",
      "default": "#ff6b2c"
    },
    {
      "type": "color",
      "id": "pop",
      "label": "Pop accent",
      "default": "#2ec4b6"
    }
  ],
  "presets": [
    {
      "name": "Vora hero"
    }
  ]
}
{% endschema %}

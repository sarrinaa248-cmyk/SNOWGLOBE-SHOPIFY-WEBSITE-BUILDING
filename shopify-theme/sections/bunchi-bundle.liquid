<section class="n-builder b-wrap" data-n-builder data-currency="{{ cart.currency.iso_code }}"><div class="b-page-heading"><span class="b-eyebrow">{{ 'numan.custom_bundles' | t }}</span><h1>{{ 'numan.builder_title' | t }}</h1><p>{{ 'numan.builder_intro' | t }}</p></div><div class="n-quiz-profile" data-n-profile hidden><strong>{{ 'numan.profile_title' | t }}</strong><p data-n-profile-text></p><a href="{{ pages['skin-quiz'].url }}">{{ 'numan.take_quiz' | t }}</a></div><div class="n-builder-settings"><label>{{ 'numan.routine' | t }}<select data-n-routine><option value="Morning">{{ 'numan.morning' | t }}</option><option value="Evening">{{ 'numan.evening' | t }}</option><option value="Both">{{ 'numan.both' | t }}</option></select></label><label>{{ 'numan.budget' | t }}<select data-n-budget><option value="0">{{ 'numan.flexible' | t }}</option><option value="3000">{{ 3000 | money }}</option><option value="6000">{{ 6000 | money }}</option><option value="10000">{{ 10000 | money }}</option></select></label><a class="b-text-link" href="{{ pages['skin-quiz'].url }}">{{ 'numan.take_quiz' | t }} ↗</a></div><div class="n-builder-layout"><div><div class="n-builder-tabs" role="group" aria-label="{{ 'numan.routine_steps' | t }}"><button type="button" data-n-step="cleanse" aria-pressed="true"><span>01</span>{{ 'numan.cleanse' | t }}</button><button type="button" data-n-step="treat" aria-pressed="false"><span>02</span>{{ 'numan.treat' | t }}</button><button type="button" data-n-step="moisturize" aria-pressed="false"><span>03</span>{{ 'numan.moisturize' | t }}</button><button type="button" data-n-step="protect" aria-pressed="false"><span>04</span>{{ 'numan.protect' | t }}</button><button type="button" data-n-step="other" aria-pressed="false"><span>05</span>{{ 'numan.other' | t }}</button></div><p class="n-step-description" data-n-description aria-live="polite"></p><div class="n-builder-find"><label>{{ 'numan.search_bundle' | t }}<input type="search" data-n-search placeholder="{{ 'numan.search_bundle_hint' | t }}"></label><label class="n-budget-filter"><input type="checkbox" data-n-budget-filter> {{ 'numan.filter_available_budget' | t }}</label></div><div data-n-filter-empty hidden><p>{{ 'numan.filter_empty' | t }}</p><button type="button" class="b-text-link" data-n-clear-filters>{{ 'numan.clear_filters' | t }}</button></div><div class="n-builder-products">{% assign shelf = section.settings.collection | default: collections.all %}{% paginate shelf.products by 50 %}{% for item in shelf.products %}{% assign available_variants = item.variants | where: 'available', true | sort: 'price' %}{% assign card_variant = available_variants.first | default: item.variants.first %}{% capture step %}{% render 'numan-product-step', item: item %}{% endcapture %}{% assign display_image = item.featured_image %}{% if item.id == 10327750541567 %}{% assign display_image = images['b5-rose-studio-v1.png'] | default: item.featured_image %}{% elsif item.id == 10327751196927 %}{% assign display_image = images['niacinamide-rose-studio-v1.png'] | default: item.featured_image %}{% elsif item.id == 10327751524607 %}{% assign display_image = images['bioaqua-rose-studio-v1.png'] | default: item.featured_image %}{% elsif item.id == 10327746806015 %}{% assign display_image = images['centella-rose-studio-v1.png'] | default: item.featured_image %}{% endif %}<article class="n-build-card" data-n-product data-step="{{ step | strip }}" data-title="{{ item.title | escape }}" data-product-id="{{ item.id }}"><a class="b-card-image{% if display_image != item.featured_image %} is-styled{% endif %}" href="{{ item.url }}?variant={{ card_variant.id }}">{% if display_image %}{{ display_image | image_url: width: 600 | image_tag: loading: 'lazy', widths: '240,400,600', sizes: '(max-width: 700px) 80vw, 28vw' }}{% endif %}</a><div class="n-build-card-info">{% assign step_label = step | strip | prepend: 'numan.' %}<span class="b-eyebrow">{{ step_label | t }}</span><h2><a href="{{ item.url }}?variant={{ card_variant.id }}">{{ item.title | escape }}</a></h2><label class="sr-only" for="NVariant-{{ item.id }}">{{ 'numan.option' | t }}</label><select id="NVariant-{{ item.id }}" data-n-variant {% if item.has_only_default_variant %}hidden{% endif %}>{% for variant in item.variants %}{% capture option_label %}{% render 'numan-option-label', variant: variant, item: item %}{% endcapture %}<option value="{{ variant.id }}" data-price="{{ variant.price }}" data-option-title="{% unless item.has_only_default_variant %}{{ option_label | strip | escape }}{% endunless %}" {% unless variant.available %}disabled{% endunless %}{% if variant.id == card_variant.id %} selected{% endif %}>{{ option_label | strip | escape }} · {{ variant.price | money }}</option>{% endfor %}</select>{% if item.id == 10327751196927 %}<p class="n-image-caption">{{ 'numan.single_bottle_shown' | t }}</p>{% endif %}<p class="n-affordable-hint" data-n-affordable-hint hidden>{{ 'numan.budget_variant_hint' | t }}</p><span data-n-price>{{ card_variant.price | money }}</span><div class="n-card-actions"><button type="button" class="b-button" data-n-select {% unless item.available %}disabled{% endunless %}>{% if item.available %}{{ 'numan.select' | t }}{% else %}{{ 'numan.sold_out' | t }}{% endif %} <span aria-hidden="true">+</span></button><a href="{{ item.url }}?variant={{ card_variant.id }}" class="b-text-link">{{ 'numan.details' | t }}</a></div></div></article>{% endfor %}{% if paginate.pages > 1 %}<div class="n-pagination">{{ paginate | default_pagination }}</div>{% endif %}{% endpaginate %}</div><div class="n-builder-empty" data-n-empty hidden><span class="n-empty-oval" aria-hidden="true">+</span><h2>{{ 'numan.empty_step' | t }}</h2><p>{{ 'numan.empty_step_note' | t }}</p><button type="button" class="b-button" data-n-next>{{ 'numan.next_step' | t }} ↗</button></div><button class="b-text-link n-next-choice" type="button" data-n-continue>{{ 'numan.next_available' | t }} →</button><noscript><p>{{ 'numan.no_js_builder' | t }}</p><a href="{{ routes.all_products_collection_url }}" class="b-button">{{ 'numan.shop_all' | t }}</a></noscript></div><aside id="bundle-summary" tabindex="-1" class="n-bundle-tray" aria-labelledby="n-tray-heading"><span class="b-eyebrow">{{ 'numan.your_selection' | t }}</span><h2 id="n-tray-heading">{{ 'numan.your_bundle' | t }}</h2><p data-n-count aria-live="polite"></p><p class="n-bundle-pricing">{{ 'numan.bundle_price_clarity' | t }}</p><p class="n-pack-note">{{ 'numan.pack_note' | t }}</p><div data-n-selection></div><div class="n-tray-total"><span>{{ 'numan.subtotal' | t }}</span><strong data-n-total>{{ 0 | money }}</strong></div><p data-n-budget-note class="n-budget-note"></p><p class="n-tray-note">{{ 'numan.shipping_note' | t }}</p><nav class="n-bundle-help"><a href="{{ pages['shipping'].url }}">{{ 'numan.help_shipping' | t }}</a><a href="{{ pages['returns'].url }}">{{ 'numan.help_returns' | t }}</a></nav><button class="b-button b-pear" type="button" data-n-add disabled>{{ 'numan.add_bundle' | t }} ↗</button><p role="status" data-n-status></p><a class="b-text-link" href="{{ routes.cart_url }}">{{ 'numan.review_bag' | t }} ↗</a></aside></div><a class="n-mobile-summary" href="#bundle-summary" data-n-summary-link><span>{{ 'numan.view_bundle' | t }}</span><strong data-n-mobile-total>{{ 0 | money }}</strong><span aria-hidden="true">↑</span></a></section>

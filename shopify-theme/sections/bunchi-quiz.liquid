<section class="b-wrap b-quiz"><div class="b-page-heading"><span class="b-eyebrow">{{ 'bunchi.no_email' | t }}</span><h1>{{ 'bunchi.quiz' | t }}</h1><p>{{ 'numan.quiz_guide_note' | t }}</p></div><div class="n-quiz-workspace"><aside class="n-quiz-guide"><span class="b-eyebrow">{{ 'numan.quiz_preview' | t }}</span><h2>{{ 'numan.quiz_guide_title' | t }}</h2><p>{{ 'numan.quiz_step_hint' | t }}</p><dl data-quiz-live-summary></dl></aside><form data-b-quiz novalidate><div class="b-quiz-progress"><span data-b-step>1 / 5</span><progress max="5" value="1" aria-label="{{ 'bunchi.progress' | t }}"></progress></div><fieldset data-b-question><legend>{{ 'bunchi.routine' | t }}</legend><div class="b-quiz-options"><label><input type="radio" name="routine" value="Morning" required><span>{{ 'bunchi.options.routine0' | t }}</span></label><label><input type="radio" name="routine" value="Evening" required><span>{{ 'bunchi.options.routine1' | t }}</span></label><label><input type="radio" name="routine" value="Both" required><span>{{ 'bunchi.options.routine2' | t }}</span></label></div></fieldset><fieldset data-b-question hidden><legend>{{ 'numan.quiz_texture' | t }}</legend><div class="b-quiz-options"><label><input type="radio" name="texture" value="Gel" required><span>{{ 'numan.quiz_gel' | t }}</span></label><label><input type="radio" name="texture" value="Cream" required><span>{{ 'numan.quiz_cream' | t }}</span></label><label><input type="radio" name="texture" value="Any" required><span>{{ 'numan.quiz_any' | t }}</span></label></div></fieldset><fieldset data-b-question hidden><legend>{{ 'numan.quiz_serum' | t }}</legend><div class="b-quiz-options"><label><input type="radio" name="serum" value="No" required><span>{{ 'numan.quiz_none' | t }}</span></label><label><input type="radio" name="serum" value="Yes" required><span>{{ 'numan.quiz_yes' | t }}</span></label></div></fieldset><fieldset data-b-question hidden><legend>{{ 'numan.quiz_pack' | t }}</legend><div class="b-quiz-options"><label><input type="radio" name="pack" value="Single" required><span>{{ 'numan.quiz_single' | t }}</span></label><label><input type="radio" name="pack" value="Multi" required><span>{{ 'numan.quiz_multi' | t }}</span></label></div></fieldset><fieldset data-b-question hidden><legend>{{ 'bunchi.budget' | t }}</legend><div class="b-quiz-options"><label><input type="radio" name="budget" value="Under $30" required><span>{{ 'bunchi.options.budget0' | t }}</span></label><label><input type="radio" name="budget" value="$30–$60" required><span>{{ 'bunchi.options.budget1' | t }}</span></label><label><input type="radio" name="budget" value="$60–$100" required><span>{{ 'bunchi.options.budget2' | t }}</span></label><label><input type="radio" name="budget" value="Flexible" required><span>{{ 'bunchi.options.budget3' | t }}</span></label></div></fieldset><div class="b-quiz-actions"><button type="button" class="b-button" data-b-back disabled>{{ 'bunchi.back' | t }}</button><button type="button" class="b-button b-pear" data-b-next disabled data-next="{{ 'bunchi.next' | t }}" data-finish="{{ 'bunchi.results' | t }}">{{ 'bunchi.next' | t }}</button></div><noscript><p>{{ 'bunchi.quiz_no_js' | t }}</p><a href="{{ routes.all_products_collection_url }}">{{ 'numan.quiz_browse' | t }}</a></noscript></form></div><div data-b-results hidden tabindex="-1"><h2>{{ 'numan.quiz_review_title' | t }}</h2><dl class="n-quiz-answer-grid" data-quiz-answer-summary></dl><p>{{ 'numan.quiz_alternative_note' | t }}</p><div class="n-quiz-picks" data-quiz-picks></div><p role="status" data-quiz-match-status></p><p class="n-quiz-total">{{ 'numan.quiz_total' | t }} <strong data-quiz-total></strong></p><p>{{ 'numan.quiz_shipping' | t }}</p><p data-quiz-time-note></p><p>{{ 'numan.quiz_review_note' | t }}</p><details class="n-quiz-explanation"><summary>{{ 'numan.quiz_how' | t }}</summary><p>{{ 'numan.quiz_method' | t }}</p></details><a data-quiz-builder class="b-button b-pear" href="{{ pages['bundle-builder'].url }}">{{ 'numan.quiz_use' | t }}</a><p class="n-image-caption">{{ 'numan.quiz_replace' | t }}</p><div class="b-actions"><button type="button" class="b-text-link" data-b-restart>{{ 'numan.quiz_restart' | t }}</button><a class="b-text-link" href="{{ routes.all_products_collection_url }}">{{ 'numan.quiz_browse' | t }}</a></div></div></section>
<script type="application/json" id="numan-quiz-catalog">[
{% assign separator = '' %}{% for item in collections.all.products %}
{% assign match_step = '' %}{% assign texture = '' %}
{% case item.id %}{% when 10327746806015 %}{% assign match_step = 'moisturize' %}{% assign texture = 'Gel' %}{% when 10327746019583 %}{% assign match_step = 'moisturize' %}{% assign texture = 'Cream' %}{% when 10327751196927, 10327751524607 %}{% assign match_step = 'treat' %}{% endcase %}
{% assign quiz_image = item.featured_image %}{% if item.id == 10327746806015 %}{% assign quiz_image = images['centella-rose-studio-v1.png'] | default: quiz_image %}{% elsif item.id == 10327751196927 %}{% assign quiz_image = images['niacinamide-rose-studio-v1.png'] | default: quiz_image %}{% elsif item.id == 10327751524607 %}{% assign quiz_image = images['bioaqua-rose-studio-v1.png'] | default: quiz_image %}{% endif %}{% if match_step != '' %}{% for variant in item.variants %}{% if variant.available %}
{{ separator }}{"id":{{ variant.id | json }},"product":{{ item.id | json }},"step":{{ match_step | json }},"texture":{{ texture | json }},"title":{{ item.title | json }},"option":{{ variant.title | json }},"price":{{ variant.price | json }},"url":{{ item.url | json }},"image":{{ quiz_image | image_url: width: 500 | json }},"multi":{% if variant.title contains 'x2' or variant.title contains 'x3' or variant.title contains 'x4' %}true{% else %}false{% endif %}}{% assign separator = ',' %}
{% endif %}{% endfor %}{% endif %}{% endfor %}]
</script>
<script type="application/json" id="numan-quiz-copy">{"currency":{{ cart.currency.iso_code | json }},"empty":{{ 'numan.quiz_empty' | t | json }},"partial":{{ 'numan.quiz_partial' | t | json }},"day_note":{{ 'numan.quiz_day_note' | t | json }},"evening_note":{{ 'numan.quiz_evening_note' | t | json }},"reason_moisturize":{{ 'numan.quiz_reason_moisturize' | t | json }},"reason_treat":{{ 'numan.quiz_reason_treat' | t | json }},"alternative":{{ 'numan.quiz_alternative' | t | json }},"one_match":{{ 'numan.quiz_one_match' | t | json }},"updated":{{ 'numan.quiz_choice_updated' | t | json }},"details":{{ 'numan.quiz_details' | t | json }}}</script>
<script src="{{ 'numan-quiz.js' | asset_url }}" defer></script>
{% schema %}{"name":"Shopping preference quiz","settings":[]}{% endschema %}

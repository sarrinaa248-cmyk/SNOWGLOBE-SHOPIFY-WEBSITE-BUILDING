<section class="n-rose-edit b-wrap" aria-labelledby="RoseEdit-{{ section.id }}"><div class="n-rose-edit-art">{% assign art = section.settings.image | default: images['centella-rose-studio-v1.png'] %}{% if art %}{{ art | image_url: width: 1000 | image_tag: loading: 'lazy', widths: '400,650,1000', sizes: '(max-width: 700px) 88vw, 45vw' }}{% endif %}<span class="n-rose-edit-light" aria-hidden="true"></span></div><div class="n-rose-edit-copy"><span class="b-eyebrow">{{ 'numan.rose_edit_eyebrow' | t }}</span><h2 id="RoseEdit-{{ section.id }}">{{ 'numan.rose_edit_title' | t }}</h2><p>{{ 'numan.rose_edit_note' | t }}</p><a class="b-button" href="{{ collections['moisturize'].url | default: routes.all_products_collection_url }}">{{ 'numan.rose_edit_shop' | t }} <span aria-hidden="true">↗</span></a><a class="b-text-link" href="{{ pages['bundle-builder'].url }}?step=moisturize">{{ 'numan.rose_edit_build' | t }} →</a><div class="n-rose-edit-caption"><span>03</span><span>{{ 'numan.moisturize' | t }}</span></div></div></section>
{% schema %}
{"name":"Rose moisturizer edit","settings":[{"type":"image_picker","id":"image","label":"Editorial image"}],"presets":[{"name":"Rose moisturizer edit"}]}
{% endschema %}

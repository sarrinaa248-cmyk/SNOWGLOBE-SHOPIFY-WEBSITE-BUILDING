<section data-n-shelf class="b-shelf b-wrap" id="b-shelf"><div class="b-section-head"><div><span class="b-eyebrow">{{ section.settings.eyebrow | escape }}</span><h2>{{ section.settings.heading | escape }}</h2></div><a class="b-text-link" href="{{ routes.all_products_collection_url }}">{{ 'bunchi.all_products' | t }} ↗</a></div><nav class="n-category-links" aria-label="{{ 'numan.browse_categories' | t }}">{% assign categories = 'cleanse,treat,moisturize,extras' | split: ',' %}{% for handle in categories %}{% assign group = collections[handle] %}{% if group.products_count > 0 %}<a href="{{ group.url }}">{{ group.title | escape }}<span aria-hidden="true">↗</span></a>{% endif %}{% endfor %}</nav>{% assign shelf = section.settings.collection | default: collections.all %}{% assign can_compare = false %}{% if shelf.products.size > 1 %}{% assign can_compare = true %}{% endif %}<div class="b-product-grid">{% for item in shelf.products limit: section.settings.limit %}{% render 'bunchi-card', item: item, context: section.id, compare: can_compare %}{% endfor %}</div>{% if can_compare %}<div class="n-compare-bar" hidden data-n-compare-bar><span>{{ 'numan.compare_help' | t }}</span><button class="b-button" type="button" data-n-compare-open disabled>{{ 'numan.compare' | t }} (<span data-n-compare-count>0</span>/3)</button><button type="button" class="b-text-link" data-n-compare-clear>{{ 'numan.clear' | t }}</button></div><p class="n-compare-status" role="status" data-n-compare-status data-limit-message="{{ 'numan.compare_limit' | t }}"></p><dialog class="n-compare-dialog" data-n-compare-dialog aria-labelledby="CompareHeading-{{ section.id }}"><div class="n-compare-heading"><h2 id="CompareHeading-{{ section.id }}">{{ 'numan.compare_products' | t }}</h2><button type="button" class="n-close" data-n-compare-close aria-label="{{ 'numan.close' | t }}">×</button></div><div class="n-compare-columns">{% for item in shelf.products limit: section.settings.limit %}<article data-n-compare-item="{{ item.id }}" hidden>{% if item.featured_image %}{{ item.featured_image | image_url: width: 400 | image_tag: loading: 'lazy', widths: '200,400', sizes: '220px' }}{% endif %}<h3>{{ item.title | escape }}</h3><h4>{{ 'numan.compare_options' | t }}</h4><ul class="n-compare-options">{% for variant in item.variants %}{% if variant.available %}<li><a href="{{ variant.url }}">{% render 'numan-option-label', item: item, variant: variant %} <strong>{{ variant.price | money }}</strong></a></li>{% endif %}{% endfor %}</ul><p>{% if item.available %}{{ 'numan.available' | t }}{% else %}{{ 'numan.sold_out' | t }}{% endif %}</p><a class="b-button" href="{{ item.url }}">{{ 'numan.details' | t }} ↗</a></article>{% endfor %}</div><p class="n-compare-footnote">{{ 'numan.compare_option_help' | t }}</p></dialog>{% endif %}</section>
{% schema %}
{
  "name": "NUMAN product shelf",
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Small heading",
      "default": "Skincare"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "On the shelf."
    },
    {
      "type": "collection",
      "id": "collection",
      "label": "Collection"
    },
    {
      "type": "range",
      "id": "limit",
      "label": "Maximum products",
      "min": 2,
      "max": 12,
      "step": 1,
      "default": 4
    }
  ],
  "presets": [
    {
      "name": "NUMAN product shelf"
    }
  ]
}
{% endschema %}

{% doc %}
  Renders a product with a Shopify product form.
  @param {product} item - Product to display
  @param {string} context - Unique section identifier
  @param {boolean} [compare] - Show comparison control
{% enddoc %}
{% assign available_variants = item.variants | where: 'available', true | sort: 'price' %}{% assign card_variant = available_variants.first | default: item.variants.first %}
{% assign form_id = 'BunchiProduct-' | append: context | append: item.id %}
{% assign display_image = item.featured_image %}{% if item.id == 10327750541567 %}{% assign display_image = images['b5-rose-studio-v1.png'] | default: item.featured_image %}{% elsif item.id == 10327751196927 %}{% assign display_image = images['niacinamide-rose-studio-v1.png'] | default: item.featured_image %}{% elsif item.id == 10327751524607 %}{% assign display_image = images['bioaqua-rose-studio-v1.png'] | default: item.featured_image %}{% elsif item.id == 10327746806015 %}{% assign display_image = images['centella-rose-studio-v1.png'] | default: item.featured_image %}{% endif %}<article class="b-card"><a class="b-card-image{% if display_image != item.featured_image %} is-styled{% endif %}" href="{{ item.url }}?variant={{ card_variant.id }}">{% if display_image %}{{ display_image | image_url: width: 700 | image_tag: loading: 'lazy', widths: '240,400,700', sizes: '(max-width: 700px) 85vw, 38vw' }}{% else %}{{ 'product-1' | placeholder_svg_tag }}{% endif %}</a><p class="n-image-caption"{% unless item.id == 10327751196927 %} aria-hidden="true"{% endunless %}>{% if item.id == 10327751196927 %}{{ 'numan.single_bottle_shown' | t }}{% endif %}</p><div class="b-card-meta"><h3><a href="{{ item.url }}?variant={{ card_variant.id }}">{{ item.title | escape }}</a></h3><span data-b-card-price>{{ card_variant.price | money }}</span></div><p class="n-options-note">{% unless item.has_only_default_variant %}{{ 'numan.product_options' | t }} · {{ item.variants.size }}{% endunless %}</p>{% form 'product', item, id: form_id, class: 'b-add-form' %}<input type="hidden" name="quantity" value="1">{% if item.has_only_default_variant %}<input type="hidden" name="id" value="{{ card_variant.id }}">{% else %}<label class="b-label" for="Variant-{{ form_id }}">{{ 'bunchi.option' | t }}</label><select id="Variant-{{ form_id }}" name="id">{% for variant in item.variants %}{% capture option_label %}{% render 'numan-option-label', variant: variant, item: item %}{% endcapture %}<option value="{{ variant.id }}" data-formatted-price="{{ variant.price | money | escape }}" {% if variant.id == card_variant.id %}selected{% endif %} {% unless variant.available %}disabled{% endunless %}>{{ option_label | strip | escape }} · {{ variant.price | money }}{% unless variant.available %} · {{ 'bunchi.sold_out' | t }}{% endunless %}</option>{% endfor %}</select>{% endif %}<button class="b-button" type="submit" {% unless item.available %}disabled{% endunless %}>{% if item.available %}{{ 'bunchi.add' | t }}{% else %}{{ 'bunchi.sold_out' | t }}{% endif %}<span aria-hidden="true">+</span></button><p class="b-add-status" role="status" aria-live="polite"></p>{% endform %}{% if compare %}<label class="n-compare-choice"><input type="checkbox" data-n-compare value="{{ item.id }}"><span>{{ 'numan.compare' | t }}</span><span class="sr-only">{{ item.title | escape }}</span></label>{% endif %}</article>
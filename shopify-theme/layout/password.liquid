<!doctype html>
<html
  class="no-js{% if request.design_mode %} shopify-design-mode{% endif %}"
  lang="{{ request.locale.iso_code }}"
>
  <head>
    {%- render 'stylesheets' -%}

    {%- if settings.favicon != blank -%}
      <link
        rel="icon"
        type="image/png"
        href="{{ settings.favicon | image_url: width: 32, height: 32 }}"
      >
    {%- endif -%}

    {% comment %}
      Opt into cross-document (MPA) view transitions and hold first paint until #MainContent
      parses, so the transition runs consistently.
      Both are gated on the same settings as the view-transitions.js opt-out switch (see snippets/scripts.liquid).
      Kept in sync with layout/theme.liquid, since the opt-in must be emitted per-layout
      (assets/base.css is shared and can't read theme settings).
    {% endcomment %}
    {% if settings.transition_to_main_product or settings.page_transition_enabled %}
      {% style %}
        @media (prefers-reduced-motion: no-preference) {
          @view-transition {
            navigation: auto;
          }
        }
      {% endstyle %}
      <link
        rel="expect"
        href="#MainContent"
        blocking="render"
        id="view-transition-render-blocker"
      >
    {% endif %}

    {%- render 'meta-tags' -%}
    {%- render 'fonts' -%}
    {%- render 'scripts' -%}
    {%- render 'theme-styles-variables' -%}
    {%- render 'color-palette' -%}

    {% if request.design_mode %}
      {%- render 'theme-editor' -%}
    {% endif %}

    {{ 'numan-access.css' | asset_url | stylesheet_tag }}
    {{ content_for_header }}
  </head>

  <body class="n-access-page">
    <main id="MainContent" class="n-access-shell">
      <div class="n-access-brand">{{ shop.name | escape }}</div>
      <section class="n-access-card" aria-labelledby="AccessHeading">
        <p class="n-access-kicker">{{ 'numan.access_preview' | t }}</p>
        <h1 id="AccessHeading">{{ 'numan.access_heading' | t }}</h1>
        <p>{{ 'numan.access_note' | t }}</p>
        {% form 'storefront_password', id: 'StoreAccess' %}
          <label for="StorePassword">{{ 'placeholders.password' | t }}</label>
          <input id="StorePassword" type="password" name="password" autocomplete="current-password" required {% if form.errors %}aria-invalid="true" aria-describedby="AccessError"{% endif %}>
          {% if form.errors %}<div id="AccessError" role="alert">{{ form.errors | default_errors }}</div>{% endif %}
          <button type="submit">{{ 'numan.access_submit' | t }}</button>
        {% endform %}
      </section>
      <details class="n-access-newsletter"><summary>{{ 'numan.access_newsletter' | t }}</summary>{{ content_for_layout }}</details>
      <a class="n-access-admin" href="/admin">{{ 'numan.access_admin' | t }}</a>
    </main>
  </body>
</html>
